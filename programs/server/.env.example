# Google Gemini API Key (Google AI Studio または Google Cloud Console で取得)
# ※制限なし(unrestricted)キーの場合は403エラーになる可能性があるため、キーの制限設定を確認してください
GEMINI_API_KEY=your_gemini_api_key_here

# 使用するGeminiモデル名
# - gemini-robotics-er-2-preview (Gemini Robotics ER 2 preview: 身体化推論・空間認識モデル)
# - gemini-2.5-flash (超低遅延・高スループット汎用Flashモデル)
GEMINI_MODEL=gemini-robotics-er-2-preview

# レイテンシ短縮のための思考設定 (リアルタイム走行制御用)
# THINKING_BUDGET: 0 (思考スキップで最速応答) または 数値
# THINKING_LEVEL: low, medium, high
GEMINI_THINKING_BUDGET=0
GEMINI_THINKING_LEVEL=low

# 車両制御パラメータ設定 (実機ハードウェアに合わせて調整可能)
CAR_SPEED_MAX=255
CAR_SPEED_MIN=-255
CAR_SPEED_CRUISE=180
CAR_STEER_MIN=0
CAR_STEER_CENTER=90
CAR_STEER_MAX=180
CAR_DURATION_MS=500

# サーバーホストおよびポート設定
HOST=0.0.0.0
PORT=8000
